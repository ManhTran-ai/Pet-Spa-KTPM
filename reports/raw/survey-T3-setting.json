p_off_time_limit_obj":[]},{"id":470321,"business_id":33290,"account_id":0,"week_day":1,"working_time":{"start":480,"end":1200},"breaks":[],"status":1,"date":"","day":"","drop_off_time_limit_obj":[]},{"id":470322,"business_id":33290,"account_id":0,"week_day":2,"working_time":{"start":480,"end":1200},"breaks":[],"status":1,"date":"","day":"","drop_off_time_limit_obj":[]},{"id":470323,"business_id":33290,"account_id":0,"week_day":3,"working_time":{"start":480,"end":1200},"breaks":[],"status":1,"date":"","day":"","drop_off_time_limit_obj":[]},{"id":470324,"business_id":33290,"account_id":0,"week_day":4,"working_time":{"start":480,"end":1200},"breaks":[],"status":1,"date":"","day":"","drop_off_time_limit_obj":[]},{"id":470325,"business_id":33290,"account_id":0,"week_day":5,"working_time":{"start":480,"end":1200},"breaks":[],"status":1,"date":"","day":"","drop_off_time_limit_obj":[]},{"id":470326,"business_id":33290,"account_id":0,"week_day":6,"working_time":{"start":480,"end":1200},"breaks":[],"status":1,"date":"","day":"","drop_off_time_limit_obj":[]}],"notifications":{"id":30965,"business_id":33290,"appt_submit_text":"Hi, your request needs to be approved by %store%. We will send a message to you once your appointment is booked successfully.","appt_accept_text":"Hi, your appointment request with us is confirmed. Appointment time: %appointment_date% %appointment_start_time%. Looking forward to seeing you soon! Best regards, %store%.","appt_reject_text":"Hi, due to a conflict in our schedule, your appointment on %appointment_date% has not been accepted. Call or text Nycole 609-816-7755, we apologize for any inconvenience. From %store%.","appt_waiting_text":"Hi, your appointment has been moved to the waiting list. Appointment time: %appointment_date% %appointment_start_time%. From %store%.","enable_accept":1,"enable_submit":1,"enable_waiting":1,"send_method":0,"notify_business_email":1},"tags":[{"label":"First Name","preview":"Scott","value":"%first_name%"},{"label":"Last Name","preview":"Williams","value":"%last_name%"},{"label":"Appointment Date","preview":"08/20/2020","value":"%appointment_date%"},{"label":"Appointment Start Time","preview":"01:00 PM","value":"%appointment_start_time%"},{"label":"Appointment End Time","preview":"02:00 PM","value":"%appointment_end_time%"},{"label":"Day Of Week","preview":"Thursday","value":"%day_of_week%"},{"label":"Pets","preview":"Rocky,Peanut","value":"%pets%"},{"label":"Services","preview":"Dog full groom,Nails cut","value":"%services%"},{"label":"Business name","preview":"Pretty Paws Cat and Dog Grooming","value":"%store%"},{"label":"Business Address","preview":"","value":"%business_address%"},{"label":"Business Phone","preview":"","value":"%business_phone%"},{"label":"Groomer","preview":"Susan","value":"%groomer%"},{"label":"Client Address","preview":"","value":"%client_address%"},{"label":"Balance","preview":"$100","value":"%balance%"}],"venues":[],"agreement_ids":"1157","agreements":[{"id":1157,"business_id":33290,"status":1,"enable":1,"header":"Policy for Dog Grooming Salon","content":"Pets are accepted for grooming with the following conditions being met and accepted by the owner or person responsible for the pet.\n\n⦁ The owner presents a pet that is healthy enough to be groomed. Grooming may expose pre-existing health and skin problems for which Pretty Paws cannot be held liable. Grooming on an elderly pet or pet with health problems is at the owner’s risk.\n\n⦁ Aggressive or Dangerous Pets: Owners MUST inform  Pretty Paws if your pet bites, has bitten, or is aggressive to people, other pets or specific grooming procedures. Muzzles or cones may be used if necessary. \n\n•Health or Medical Problems \u0026 Senior Pets: Grooming procedures can sometimes be stressful, especially for a senior pet or pet with health problems, and can expose hidden medical problems or aggravate a current one during or after the groom. Because senior pets and pets with health problems have a greater chance of injury, these pets will be groomed for cleanliness and comfort, in styles that will not add to their stress. In the best interest of your pet, this Agreement gives Pretty Paws  permission to obtain immediate veterinary treatment for your pet should it be deemed necessary by the staff. We will do our best to contact you first, then take your pet to the nearest Veterinarian or to our Emergency Veterinarian. All expenses for Veterinary care are the responsibility of the pet’s owner.\n\n⦁ The owner understands that de-matting, shaving, and clipping may cause hair loss, patchiness, skin irritations, sores, or cuts and may expose pre-existing skin conditions.  Pretty Paws will not be held responsible.\n\n⦁ No-Shows \u0026 Cancellations: Cancellations with less than 24-hour notice are subject to a $10.00 *FEE PER PET* which will be added to your next ticket. No Shows will be required payment of the full price of the missed appointment before another appointment may be scheduled. If a second No Show occurs, you will be\nrequired to pay for the full price of the missed appointment as well as pre-pay for the next schedule appointment. We understand there may be emergency situations and will work with you, but not on a continued basis. Please be respectful of our time as we are a by-appointment business, and another client could have taken your appointment if we had known. A 24-hour cancellation notice is required to avoid fees. \n\nI agree with Pretty Paws policies.","is_fullrich":0,"color_code":"#39BA5D","need_card":0,"sign_required":0,"accept_pet_type":"","create_time":1698029396,"update_time":1739583711,"import_id":0,"signed_status":0,"last_send_time":0}],"location_id":"L4T5C1H927738","card_payment":1,"stripe_account":"","need_business_address":1,"client_questions":[],"pet_questions":[{"id":745819,"business_id":33290,"form_id":0,"application":0,"client_type":0,"question_type":2,"all_appointment_types":1,"available_appointment_types":"","is_default":1,"question":"Pet Image