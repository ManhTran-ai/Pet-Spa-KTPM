{"code":200,"data":{"obj":{"id":31420,"business_id":33290,"enable":1,"earliest_booking":0,"latest_booking":6,"soonest_time":0,"phone_number":"+16098167755","website":"","address1":"","address2":"","city":"Hamilton","state":"NJ","country":"US","postal_code":"","lat":"39.450958","lng":"-74.642714","facebook":"https://www.facebook.com/profile.php?id=61550821567798\u0026mibextid=LQQJ4d","yelp":"","instagram":"https://instagram.com/catanddoggroomingnj?igshid=MzMyNGUyNmU2YQ%3D%3D\u0026utm_source=qr","confirm_note":"","google":"","email":"nycoleco@yahoo.com","logo":"https://groope.s3-us-west-2.amazonaws.com/public/uploads/2023-10-17/ckmvr80s309vtldguvl0.png","about_us":"My name is Nycole, and I’m the owner and groomer behind Pretty Paws Cat and Dog Grooming! 🩷🐾\n\nI’ve been grooming for over 10 years and have had the pleasure of working with cats and dogs of all sizes and breeds. Animals have always been a huge part of my life, and I’m a true animal lover with pets of my own, ranging from cats to horses! 🐱🐶🐴\n\nAt Pretty Paws, I believe every pet deserves patience, love, and individualized care. That’s why I offer a kennel-free grooming experience, where each pet is groomed straight through with one-on-one attention in a calm, relaxed environment.\n\nMy goal is to make every visit feel like a little spa day for your babies, treating each one with the same love and care I give my own. Thank you for trusting me with your furry family members. It truly means so much to me! 🩷🐾","pet_photos":"https://groope.s3-us-west-2.amazonaws.com/public/uploads/2023-10-17/ckn0b38s309vtldgvlc0.png,https://groope.s3-us-west-2.amazonaws.com/public/uploads/2023-10-17/ckn0b533meja8cmtcr3g.png,https://groope.s3-us-west-2.amazonaws.com/public/uploads/2023-10-17/ckn0b733meja8cmtcr5g.png,https://groope.s3-us-west-2.amazonaws.com/public/uploads/2023-10-17/ckn0b90s309vtldgvlhg.png,https://groope.s3-us-west-2.amazonaws.com/public/uploads/2023-10-17/ckn0bbb3meja8cmtcrf0.png,https://groope.s3-us-west-2.a