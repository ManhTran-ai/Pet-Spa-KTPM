{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "API Hệ thống Đặt lịch Dịch vụ Chăm sóc Thú cưng / Spa",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration --passWithNoTests",
    "test:system": "jest --selectProjects system --passWithNoTests",
    "test:nfr": "jest --selectProjects nfr --passWithNoTests",
    "test:regression": "jest --selectProjects unit --selectProjects integration --selectProjects system --passWithNoTests",
    "test:coverage": "jest --coverage --selectProjects unit --selectProjects integration --selectProjects system --passWithNoTests",
    "test:json": "jest --json --outputFile=../../reports/raw/jest.json --selectProjects unit --selectProjects integration --selectProjects system --passWithNoTests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
