{
  "info": {
    "name": "Pet Spa KTPM — API doc cua site dich",
    "description": "Chi GET theo ADR-11. Endpoint rut tu network log quan sat duoc ngay 2026-11-13; neu endpoint khong con ton tai thi ghi vao defect log thay vi xoa. Moi request co assertion HTTP 200 de Newman bao cao co ket qua that.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-T2-M1-001: T2 Mat Pet — trang spa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tra ve HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "text/html" }],
        "url": { "raw": "https://matpet.vn/spa", "protocol": "https", "host": ["matpet", "vn"], "path": ["spa"] }
      }
    },
