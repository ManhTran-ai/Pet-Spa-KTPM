{
  "name": "petspa",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống Đặt lịch Dịch vụ Chăm sóc Thú cưng / Spa",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test:unit && npm run test:integration && npm run test:system",
    "test:unit": "npm run test:unit --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "test:system": "npm run test:system --workspace server",
    "test:coverage": "npm run test:coverage --workspace server",
    "test:nfr": "npm run test:nfr --workspace server",
    "test:regression": "npm run test:regression --workspace server",
    "tc:sync": "node scripts/tc-sync.mjs",
    "tc:record": "node scripts/tc-record.mjs",
    "rtm:check": "node scripts/rtm-check.mjs",
    "exit:check": "node scripts/exit-check.mjs",
    "report:static": "node scripts/static-analysis.mjs",
    "docs:openapi": "node scripts/openapi-check.mjs",
    "infra:check": "node scripts/infra-check.mjs",
    "export:docs": "node scripts/export-docs.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
