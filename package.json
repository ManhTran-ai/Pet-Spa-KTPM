{
  "name": "petspa-ktpm",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ testware kiểm thử hộp đen/hộp xám cho 3 hệ thống web Pet Spa (T1 Pet NGON, T2 Mật Pet Family, T3 Pretty Paws)",
  "type": "module",
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:t1": "playwright test --project=t1",
    "test:e2e:t2": "playwright test --project=t2",
    "test:e2e:t3": "playwright test --project=t3",
    "test:perf": "k6 run tests/perf/read-load.js",
    "test:a11y": "playwright test --project=security tests/security/accessibility.spec.ts",
    "test:cross-browser": "playwright test --project=cross-browser-chromium --project=cross-browser-firefox --project=cross-browser-webkit --project=cross-browser-edge",
    "lint": "eslint tests scripts",
    "typecheck": "tsc --noEmit",
    "req:check": "node scripts/req-check.mjs",
    "rtm:build": "node scripts/rtm-build.mjs",
    "rtm:check": "node scripts/rtm-check.mjs",
    "backlog:build": "node scripts/backlog-build.mjs",
    "exit:check": "node scripts/exit-check.mjs",
    "lh:scan": "node scripts/lighthouse-scan.mjs",
    "exec:sync": "node scripts/exec-sync.mjs",
    "gate": "npm run req:check && npm run rtm:check && npm run exit:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "lighthouse": "^12.3.0",
    "typescript": "^5.7.3"
  }
}
